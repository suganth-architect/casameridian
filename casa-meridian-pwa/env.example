# ─────────────────────────────────────────────────────────────────────────────
# Casa Meridian PWA – Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (public, safe to expose to browser) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only, NEVER expose to browser) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use the raw PEM key – Vercel handles newlines automatically.
FIREBASE_PRIVATE_KEY=
# Bucket name only, e.g. "your-project.appspot.com" (NOT firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── Google AI (Gemini) ────────────────────────────────────────────────────────
GOOG_API_KEY=
# Optional: override default model names
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_IMAGE_MODEL_FALLBACK=gemini-3-flash-preview
# GEMINI_IMAGE_MODEL_FALLBACK_2=gemini-2.0-flash-exp

# ── Airbnb iCal Sync ─────────────────────────────────────────────────────────
# Your Airbnb calendar export URL for availability sync
AIRBNB_ICAL_URL=

# ── App Config ────────────────────────────────────────────────────────────────
# Price per night in INR (integer)
CASA_PRICE_PER_NIGHT=50000
